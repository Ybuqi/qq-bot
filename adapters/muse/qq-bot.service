[Unit]
Description=qq-bot QQ official Bot bridge (pull delivery for Muse)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=__USER__
Environment=HOME=__HOME__
WorkingDirectory=__HOME__
EnvironmentFile=-__HOME__/.config/qq-bot/env
ExecStart=__HOME__/.local/bin/qq-bot run
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
MemoryMax=256M

[Install]
WantedBy=default.target
